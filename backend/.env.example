# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/ranobe-hub

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secret (Use a strong random string, at least 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# Admin Password Hash
# Generate with: npm run hash-password
ADMIN_PASSWORD=$2b$10$X4wURQY0uQaLlfozM1PKlu.lG8JK78L6dDu1HTrA4k/LBGaiuJehW

# Email Configuration (Office365/Outlook)
EMAIL_USER=your-email@outlook.com
EMAIL_PASSWORD=your-app-specific-password
ADMIN_EMAIL=admin@example.com
